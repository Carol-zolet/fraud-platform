# Exemplo de variáveis de ambiente para a plataforma de fraudes

# JWT agora usa RS256 (chaves assimétricas), não um secret simétrico.
# auth-service assina com keys/private.pem, api-gateway verifica com keys/public.pem.
# Não é necessária nenhuma variável de ambiente para isso — apenas garanta que
# keys/private.pem e keys/public.pem existam na raiz do projeto.

KAFKA_BROKER=localhost:29092
REDIS_HOST=localhost
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
MONGO_USER=fraud_user
MONGO_PASSWORD=fraud_pass
REDIS_PASSWORD=fraud_redis_pass
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
